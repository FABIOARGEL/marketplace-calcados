# ============================================================
# .env.example — Variáveis de Ambiente (Marketplace de Calçados)
#
# IMPORTANTE: Este arquivo é um EXEMPLO.
# Copie para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# ----------------------------------------------------------
# Django — Configurações Principais
# ----------------------------------------------------------

# Chave secreta do Django (gere uma nova com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=sua-chave-secreta-aqui-nao-use-em-producao

# Modo debug (True apenas em desenvolvimento)
DEBUG=True

# Hosts permitidos (separados por vírgula)
# Exemplo: ALLOWED_HOSTS=localhost,127.0.0.1,meudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# Banco de Dados — PostgreSQL
# ----------------------------------------------------------

DB_NAME=marketplace_calcados
DB_USER=postgres
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=5432
